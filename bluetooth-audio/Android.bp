cc_binary {
    name: "android.hardware.bluetooth.audio-service",
    vendor: true,
    relative_install_path: "hw",

    srcs: [
        "service.cpp",
    ],

    shared_libs: [
        "android.hardware.bluetooth.audio-impl",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],

    init_rc: [
        "android.hardware.bluetooth.audio-service.rc",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
