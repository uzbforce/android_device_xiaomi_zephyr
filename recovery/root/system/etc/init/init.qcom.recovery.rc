#
# Copied from the stock recovery ramdisk
# (zephyr_global_images_OS3.0.311.0.WBUMIXM_16.0), same path and file name.
# Stock puts it in /system/etc/init, which init always parses; importing it as
# /init.recovery.${ro.hardware}.rc depends on ro.hardware resolving to "qcom"
# at that point.
#
# What it provides, and why recovery needs it:
#
#   - sys.usb.configfs=1: Lineage's generic recovery init.rc defaults to 0,
#     which drives the legacy /sys/class/android_usb interface this kernel does
#     not have;
#   - sys.usb.controller and the dwc3 peripheral mode: without a UDC name the
#     gadget is never bound, so neither adbd nor fastbootd enumerate;
#   - /dev/block/bootdevice: the device fstab uses it for misc, data, persist,
#     modem, dsp and bluetooth, and recovery's bootloader-control-block code
#     reads the /misc entry from that fstab. If the link is missing, recovery
#     cannot clear the BCB and the bootloader keeps restarting recovery;
#
#   - touch: ft3683g_spi and its dependencies are staged in the recovery
#     ramdisk at /vendor_dlkm/lib/modules, because recovery does not mount the
#     vendor_dlkm partition. They are loaded in the on fs action below.
#     Loading ft3683g_spi from modules.load.recovery probes before its
#     dependencies are loaded and panics the kernel.

on init
    write /sys/class/backlight/panel0-backlight/brightness 200

    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # These three modules are staged in the recovery ramdisk at
    # /vendor_dlkm/lib/modules: recovery does not mount vendor_dlkm, so the
    # stock vendor_dlkm paths do not exist here. Loading ft3683g_spi from
    # modules.load.recovery probes before its dependencies are loaded and
    # panics the kernel. xiaomi_tp needs miev, and ft3683g_spi needs
    # xiaomi_tp + lct_tp; the other dependencies (hardware_info,
    # lx_charger_class, panel_event_notifier, spi-msm-geni, msm_drm) are
    # already in modules.load.recovery.
    wait /vendor_dlkm/lib/modules/ft3683g_spi.ko
    insmod /vendor_dlkm/lib/modules/xiaomi_tp.ko
    insmod /vendor_dlkm/lib/modules/lct_tp.ko
    insmod /vendor_dlkm/lib/modules/ft3683g_spi.ko

# update_engine_sideload looks up android.hardware.boot.IBootControl through
# servicemanager, while the vendor only ships the HIDL 1.2 service and recovery
# has no hwservicemanager. This is the QTI AIDL service built for recovery; it
# lives in the ramdisk, so it works against the stock vendor too.
on boot
    start vendor.boot-qti
