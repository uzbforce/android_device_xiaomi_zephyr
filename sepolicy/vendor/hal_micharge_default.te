# Xiaomi's HIDL charging HAL
# (/vendor/bin/hw/vendor.xiaomi.hardware.micharge@1.0-service). Stock starts it
# as micharge-hal-1-0 from vendor.xiaomi.hardware.micharge@1.0-service.rc, but
# the binary shipped unlabeled: init found no domain transition, the service
# never started, and lshal reports
#
#   X ? vendor.xiaomi.hardware.micharge@1.0::I*/* (/vendor/lib/hw/) N/A N/A
#
# The HAL is the userspace half of the Xiaomi charging stack (charge-pump
# policy, charge current/voltage limits, smart charging). Without it the kernel
# falls back to the generic 5 V path and the SC charge pump stays offline
# (present=0), which is why charging is slower than stock.
#
# The blob writes the charger/power-supply sysfs surface, which keeps the
# generic sysfs label on zephyr (see hal_health_default.te), so grant that
# directly. The rules are intentionally broad over sysfs/proc/vendor_file:
# the HAL walks the whole power-supply tree, and a partial rule set would only
# turn a denied node into a silent restart loop. The domain must stay
# enforcing - user builds reject extra permissive domains.
type hal_micharge_default, domain;
type hal_micharge_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_micharge_default)
hwbinder_use(hal_micharge_default)
vndbinder_use(hal_micharge_default)
add_hwservice(hal_micharge_default, hal_micharge_hwservice)

# The HAL opens the hwservicemanager property context while resolving its
# HIDL service. Without this it retries the lookup and produces the 3/s AVC
# storm seen in the audit (27,490 denials on the old build).
get_prop(hal_micharge_default, hwservicemanager_prop)

allow hal_micharge_default vendor_file:dir r_dir_perms;
allow hal_micharge_default vendor_file:file { execute getattr map open read };
allow hal_micharge_default vendor_file:lnk_file read;

# Battery/charger nodes are covered by the generic sysfs type on zephyr; the
# class/power_supply entries are symlinks, hence the lnk_file rule.
allow hal_micharge_default sysfs:dir r_dir_perms;
allow hal_micharge_default sysfs:file rw_file_perms;
allow hal_micharge_default sysfs:lnk_file read;

allow hal_micharge_default proc:dir r_dir_perms;
allow hal_micharge_default proc:file r_file_perms;
