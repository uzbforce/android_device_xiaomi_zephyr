# /data/vendor/wlan_logs is created by init at post-fs-data, but QCOM's
# file_contexts only labels /data/vendor/wifi/wlan_logs. Label the actual path
# and let the post-fs-data restorecon move the existing directory and its logs
# to vendor_wifi_vendor_log_data_file. Only vendor_init performs this relabel.
allow vendor_init vendor_data_file:dir { getattr open read search relabelfrom };
allow vendor_init vendor_data_file:file { getattr relabelfrom };
allow vendor_init vendor_wifi_vendor_log_data_file:dir { getattr open read search relabelto };
allow vendor_init vendor_wifi_vendor_log_data_file:file { getattr relabelto };

# /mnt/vendor/persist is mounted with vendor_firmware_file as the default
# context, so the Goodix calibration files arrive with that label even though
# their file_contexts entry says vendor_fingerprint_data_file. The fingerprint
# init script's restorecon_recursive was denied on relabelfrom, leaving the
# files mislabeled and the TEE unable to read them. Allow vendor_init to
# perform exactly that firmware -> fingerprint-data relabel.
allow vendor_init vendor_firmware_file:file { getattr relabelfrom };
allow vendor_init vendor_fingerprint_data_file:dir { getattr open read search };
allow vendor_init vendor_fingerprint_data_file:file { getattr relabelto };
