# qseecomd serves the fingerprint TA: the TA asks the listener service to load
# /mnt/vendor/persist/goodix/gf_cali_persist.so (and rewrite it as calibration
# drifts). Denied, the TA initialises without calibration, SPMT is reported as
# not passed, and enrollment is rejected before the sensor is armed (see
# file.te).
allow tee vendor_fingerprint_data_file:dir rw_dir_perms;
allow tee vendor_fingerprint_data_file:file rw_file_perms;
