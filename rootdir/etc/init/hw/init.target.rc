import /vendor/etc/init/hw/init.qti.kernel.rc

on early-init
    write /proc/sys/kernel/sched_boost 1
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.qti.early_init.sh
    setprop ro.soc.model ${ro.vendor.qti.soc_model}

on init
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1
    #Moving to init as this is needed for qseecomd
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start vendor.qseecomd
    # Start vold early, as the stock vendor init does. vold waits for /data
    # itself before creating the emulated volume, so starting it here lets
    # StorageManagerService find and mount /storage/emulated/0 at boot.
    start vold

on fs
    start hwservicemanager
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    mount ext4 /dev/block/bootdevice/by-name/rescue /mnt/rescue noatime
    restorecon_recursive /mnt/rescue
    mkdir /dev/logfs 0771 system system
    mount vfat /dev/block/bootdevice/by-name/logfs /dev/logfs noatime umask=006,uid=1000,gid=1000
    chown system system /dev/mi_display/disp_feature
    chmod 0664 /dev/mi_display/disp_feature



on post-fs
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864
    # dfx misight miev
    chmod 0662 /dev/miev
    restorecon /dev/miev
on late-fs
    wait_for_prop hwservicemanager.ready true
    class_start early_hal
    mount_all --late

on post-fs-data
    mkdir /vendor/data/tombstones 0771 system system
    #add for wifi 9434 log
    mkdir /data/vendor/wlan_logs 0770 system wifi
    # QCOM labels /data/vendor/wifi/wlan_logs; this device uses the direct
    # path, so apply the same label here before cnss_diag starts.
    restorecon_recursive /data/vendor/wlan_logs
    # Enable WLAN cold boot calibration
    write /sys/kernel/cnss/fs_ready 1

    #Thermal
    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system
    chown system system /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/boost
    chown system system /sys/class/thermal/thermal_message/temp_state
    chown system system /sys/class/thermal/thermal_message/thermal_max_brightness
    chown system system /sys/class/thermal/thermal_message/balance_mode
    chown system system /sys/class/mi_display/disp-DSI-0/thermal_hbm_disabled
    chmod 0664 /sys/class/mi_display/disp-DSI-0/thermal_hbm_disabled
    chown system system /sys/class/thermal/thermal_message/charger_temp
    chown system system /sys/class/thermal/power_save/powersave_mode
    chown system system /sys/class/thermal/power_save/power_level
    chown system system /sys/class/power_supply/battery/constant_charge_current
    chmod 0664 /sys/class/power_supply/battery/constant_charge_current
    chown system system /sys/class/power_debug/temp_aware 

    chown 0664 /sys/class/power_supply/battery/revchg_bcl
    chown system system /sys/class/power_supply/battery/revchg_bcl
    #Enable SSR
    setprop persist.vendor.ssr.restart_level ALL_ENABLE

on early-boot
    start vendor.sensors

on boot
    write /dev/cpuset/audio-app/cpus 4-7
    chown system system /sys/class/thermal/thermal_message/boost
    chmod 0664 /sys/class/thermal/thermal_message/boost
    chown system system /sys/class/thermal/thermal_message/balance_mode
#USB controller configuration
    setprop vendor.usb.rndis.func.name "gsi"
    setprop vendor.usb.rmnet.func.name "gsi"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss_sw"
    setprop vendor.usb.controller 4e00000.dwc3
#qvga
    chown cameraserver cameraserver /sys/class/qvga/qvga/rear_qvga
    chmod 0666 /sys/class/qvga/qvga/rear_qvga
    chown cameraserver cameraserver /sys/class/qvga/qvga/cam_name
    chmod 0666 /sys/class/qvga/qvga/cam_name

on boot && property:persist.vendor.usb.controller.default=*
    setprop vendor.usb.controller ${persist.vendor.usb.controller.default}

on boot
#hardwareinfo
    chmod 0660 /dev/hardwareinfo
    chown root system /dev/hardwareinfo
#Display
    chmod 0660 /sys/class/mi_display/disp-DSI-0/mipi_rw
    chown system system /sys/class/mi_display/disp-DSI-0/mipi_rw
    chmod 0660 /sys/class/mi_display/disp-DSI-0/cell_id
    chown system system /sys/class/mi_display/disp-DSI-0/cell_id
    chmod 0660 /sys/class/mi_display/disp-DSI-0/disp_count
    chown system system /sys/class/mi_display/disp-DSI-0/disp_count
    chmod 0660 /sys/class/mi_display/disp-DSI-0/disp_param
    chown system system /sys/class/mi_display/disp-DSI-0/disp_param
    chmod 0660 /sys/class/mi_display/disp-DSI-0/doze_brightness
    chown system system /sys/class/mi_display/disp-DSI-0/doze_brightness
    chmod 0660 /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chown system system /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chmod 0660 /sys/class/mi_display/disp-DSI-0/panel_info
    chown system system /sys/class/mi_display/disp-DSI-0/panel_info
    chmod 0660 /sys/class/mi_display/disp-DSI-0/wp_info
    chown system system /sys/class/mi_display/disp-DSI-0/wp_info

on boot
    chown system system /sys/class/touch/touch_dev/palm_sensor
    chmod 0664 /sys/class/touch/touch_dev/palm_sensor

on property:vendor.usb.controller=*
    setprop sys.usb.controller ${vendor.usb.controller}

#+ExtR HONGMI-168554, p-wangpeng39, 20230330, add, for gt_tg configuration single card requirements
on property:ro.boot.multisim=*
    setprop persist.radio.multisim.config ${ro.boot.multisim}

on property:ro.miui.customized.region=lm_cr
    setprop persist.radio.multisim.config ssss
#-ExtR HONGMI-168554, p-wangpeng39, 20230330, add, for gt_tg configuration single card requirements

#Chk148653,wt-wangpeng6,add,2023.04.13,clear imei2 on single sim version. begin
on property:persist.radio.multisim.config=ssss
    setprop persist.vendor.radio.imei2 ""
    setprop persist.radio.imei2 ""
#Chk148653,wt-wangpeng6,add,2023.04.13,clear imei2 on single sim version. end

on charger
    start vendor.power_off_alarm
    setprop vendor.usb.controller 4e00000.dwc3
    setprop sys.usb.configfs 1

#pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

#Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

service vendor.mdm_helper /vendor/bin/mdm_helper
    user root
    class core
    group system wakelock
    disabled
    
service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    user root
    class core
    oneshot

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

on property:vold.decrypt=trigger_restart_framework
   start vendor.cnss_diag

on property:persist.vendor.cnss_diag.enable=true
    start vendor.cnss_diag
on property:persist.vendor.cnss_diag.enable=false
    stop vendor.cnss_diag

service vendor.cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
   class main
   user system
   group system wifi inet sdcard_rw media_rw diag
   oneshot

service fatal_err_check /vendor/bin/check_fatal_err.sh
    class late_start
    user root
    group root
    oneshot

service dcvs-sh /vendor/bin/init.qti.dcvs.sh
    class late_start
    user root
    group root system
    disabled
    oneshot

on property:vendor.dcvs.prop=1
   start dcvs-sh

on init
    insmod /vendor/lib/modules/millet_core.ko
    insmod /vendor/lib/modules/binder_gki.ko
    insmod /vendor/lib/modules/millet_binder.ko
    insmod /vendor/lib/modules/millet_hs.ko
    insmod /vendor/lib/modules/millet_pkg.ko
    insmod /vendor/lib/modules/millet_sig.ko
    insmod /vendor/lib/modules/millet_oem_cgroup.ko

#add display svi
service svi_on /vendor/bin/ppd "svi:on"
    user root
    class main
    group root system
    oneshot
    disabled
on property:ro.vendor.display.svi=1 && property:sys.boot_completed=1
    start svi_on

#add for wifi 9434 log
service vendor.tcpdump /vendor/bin/vendor_tcpdump -i any -W 2 -C 2 -s 134 -w /data/vendor/wlan_logs/tcpdump.pcap -Z system
    class main
    user root
    group root wifi inet sdcard_rw media_rw diag
    disabled
    oneshot
service sniffer /vendor/bin/vendor_tcpdump -i wlan0 -w /data/vendor/wlan_logs/sniffer.pcap
    class main
    user root
    group root
    disabled
    oneshot
on property:persist.vendor.tcpdump.enable=true
    start vendor.tcpdump
on property:persist.vendor.tcpdump.enable=false
    stop vendor.tcpdump
on property:persist.sys.cota.carrier=OR
    stop vendor.tcpdump
service startpktlog /system/vendor/bin/iwpriv wlan0 pktlog 2
    class main
    user root
    group root
    disabled
    oneshot
service stoppktlog /system/vendor/bin/iwpriv wlan0 pktlog 0
    class main
    user root
    group root
    disabled
    oneshot
on property:ro.debuggable=1 && property:sys.bootstat.first_boot_completed=0
    setprop persist.vendor.cnss_diag.enable true
    setprop persist.vendor.tcpdump.enable true
# add end

on property:dev.bootcomplete=1 
     chown system system /sys/class/power_supply/battery/smart_fv
     chmod 0660 /sys/class/power_supply/battery/smart_fv

on property:vendor.audio.usb_cctoggle=1
    write /sys/class/power_supply/usb/audio_usb_cctoggle 1
on property:vendor.audio.usb_cctoggle=0
    write /sys/class/power_supply/usb/audio_usb_cctoggle 0

