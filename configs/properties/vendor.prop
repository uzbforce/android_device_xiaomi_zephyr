# Goodix under-display fingerprint — values verified in the stock vendor/build.prop
#
# libhardware resolves hw/fingerprint.<ro.hardware.fingerprint>.so, so this is
# what makes hw/fingerprint.goodix_fod.so load. It was previously set by the
# stock image only; the AIDL HAL reads it through hw_get_module().
ro.hardware.fingerprint=goodix_fod
ro.hardware.fp.fod=true
ro.hardware.fp.fod.location=low
ro.hardware.fp.fod.touch.ctl.version=2.0
ro.hardware.fp.fod.lowlight.lux.threshold=3
ro.hardware.fp.fod.lowlight.brightness.threshold=411
persist.vendor.sys.fp.fod.location.X_Y=451,2109
persist.vendor.sys.fp.fod.size.width_height=178,178
persist.vendor.sys.fp.expolevel=0x88

# Local HBM, restored from the stock vendor/build.prop. The FOD engine drives
# the panel's FOD illumination through this switch; with it unset the sensor is
# armed but the green spot never turns on, so every captured frame is dark and
# enrollment sits at "waiting for finger" until the 60 s timeout.
ro.vendor.localhbm.enable=true

# Read by android.hardware.biometrics.fingerprint-service.lineage (the AIDL
# wrapper that replaced the stock HIDL 2.1 service) instead of by a VINTF
# fragment, so the sensor description lives here:
#
#   type            selects FingerprintSensorType::UNDER_DISPLAY_OPTICAL and,
#                   with it, the ISession#onPointerDown path that arms FOD.
#                   The wrapper only accepts default/rear, udfps, udfps-us and
#                   side; `udfps` is the optical under-display value and any
#                   other string is a fatal UNIMPLEMENTED() abort at startup.
#   sensor_location is <x>|<y>|<radius> in pixels; 540/2198/89 is this panel's
#                   sensor centre (also used by config_udfps_sensor_props)
#   (the libhardware module itself is selected by ro.hardware.fingerprint above)
#
# Without `type` the wrapper falls back to UNKNOWN, the framework treats the
# sensor as rear-mounted and never sends display touches.
persist.vendor.fingerprint.type=udfps_optical
persist.vendor.fingerprint.sensor_location=540|2198|89
persist.vendor.fingerprint.sensor_id=0
persist.vendor.fingerprint.sensor_strength=2
persist.vendor.fingerprint.navigation_gesture=false
# detectInteraction() is not implemented in the wrapper, so leave it off rather
# than advertising a capability that answers UNABLE_TO_PROCESS.
persist.vendor.fingerprint.detect_interaction=false

# WCN3950 Wi-Fi/BT combo
ro.hardware.wlan.chip=wcn3950
ro.hardware.wlan.vendor=qcom
ro.hardware.wlan.dbs=0
ro.hardware.wlan.mimo=0

# Adreno graphics — values from the stock vendor/build.prop. libEGL picks its
# driver by ro.hardware.egl and aborts with "couldn't find an OpenGL ES
# implementation" when it is unset, which takes SurfaceFlinger and zygote with
# it; the Vulkan loader and HWUI read the other two.
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno

# libhardware resolves the primary audio HAL as audio.primary.<ro.hardware>.
# ro.hardware is qcom on this boot chain (androidboot.hardware), but the QTI
# HAL is built as audio.primary.bengal.so. Without this the audio service falls
# back to the 11 KB AOSP stub, never loads the QTI HAL that registers
# vendor.qti.hardware.AGMIPC, and AudioService blocks in
# AudioSystem.setLowRamDevice until the watchdog kills system_server 67 s later.
ro.hardware.audio.primary=bengal

# Audio, restored verbatim from the stock HyperOS vendor/build.prop. This tree
# regenerates vendor/build.prop from the files in this directory, so none of the
# stock audio block was being shipped: the HAL, PAL and AGM are all stock blobs
# and read these at runtime, and with every key absent they fall back to their
# compiled-in defaults. vendor.audio_hal.period_size/in_period_size/
# period_multiplier set the PCM buffer geometry the HAL asks the DSP for, and
# vendor.audio.feature.* gate the code paths inside the blob (FM, HFP, compress
# capture, keep-alive, deep-buffer-as-primary, and so on).
# ro.config.notification_sound is deliberately not copied; Lineage sets its own.
ro.vendor.audio.fweffect=true
ro.vendor.audio.feature.customizedsound=true
ro.vendor.audio.misound.bluetooth.enable=true
ro.vendor.audio.soundfx.type=mi
ro.vendor.audio.soundfx.usb=true
ro.audio.monitorRotation=false
ro.vendor.audio.spk.stereo=false
ro.vendor.audio.surround.support=false
ro.vendor.audio.scenario.support=true
ro.vendor.audio.sfx.scenario=false
ro.vendor.audio.vocal.support=true
ro.vendor.audio.sfx.earadj=true
ro.vendor.audio.sdk.fluencetype=none
ro.vendor.audio.sdk.ssr=false
ro.vendor.audio.voice.change.support=true
ro.vendor.audio.voice.change.version=1
ro.vendor.audio.policy.engine.odm=true
ro.vendor.audio.sos=true
ro.vendor.audio.game.mode=false
ro.vendor.audio.feature.fade=true
ro.vendor.audio.cota_default_volume_fortg=9
ro.vendor.audio.volume_super_customsetstreamtype=true
ro.vendor.audio.volume_super_index_add=10
ro.vendor.audio.volume_super_streamtype=44
ro.vendor.audio.volume_super_percent=200
ro.vendor.audio.volume_super_version=type_p_1
ro.vendor.audio.volume_super_percent_extensible={"1":200}
ro.qc.sdk.audio.ssr=false
ro.qc.sdk.audio.fluencetype=none
persist.vendor.audio.ambisonic.capture=false
persist.vendor.audio.ambisonic.auto.profile=false
persist.vendor.audio.apptype.multirec.enabled=false
persist.vendor.audio.fluence.voicecall=true
