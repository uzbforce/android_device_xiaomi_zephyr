ro.opengles.version=196610

# USB. Nothing picks a composition before system_server on this port:
# init.usb.rc copies persist.sys.usb.config and init.qcom.usb.rc copies
# persist.vendor.usb.config, and the stock vendor/build.prop that carried the
# vendor.usb.* set is not shipped. Without a composition the gadget is never
# bound and adbd never starts, so adb is missing exactly while the boot is still
# coming up. mass_storage,adb is the one composition the shipped
# init.qcom.usb.rc can bind end to end on its own, and use_gadget_hal=0 keeps it
# on init's configfs path instead of the usbd/gadget-HAL path, which needs props
# and a daemon this image does not carry.
vendor.usb.controller=4e00000.dwc3
vendor.usb.use_gadget_hal=0
# FunctionFS MTP/PTP. This kernel has no legacy mtp.gs0/ptp.gs1 configfs
# functions, so File transfer only works through the ffs.mtp/ffs.ptp path:
# this makes init create and mount /dev/usb-ffs/{mtp,ptp} at post-fs-data.
# The stock vendor/build.prop carried both of these; the regenerated one lost
# them, which is why Windows never saw an MTP device.
vendor.usb.use_ffs_mtp=1
sys.usb.mtp.batchcancel=1
persist.vendor.usb.config=mass_storage,adb
persist.sys.usb.config=mass_storage,adb

# Gatekeeper. /vendor/etc/init/android.hardware.gatekeeper@1.0-service-qti.rc
# ships gatekeeper-1-0 as a disabled service and only enables it from this
# property. The stock vendor/build.prop carried it as 0 (SPU off, TEE-backed
# gatekeeper) and we regenerate vendor/build.prop, so the flag has to live here.
# Without it the HAL never starts and gatekeeperd has no device to enroll or
# verify against.
vendor.gatekeeper.is_security_level_spu=0

# Display. The composer HAL crashes in ValidateDisplayInternal about 35 s
# after enable_screen:
#   #00 sdm::HWCDisplayBuiltIn::HandleLargeCompositionHint(bool)+68
#   #01 sdm::HWCSession::ValidateDisplayInternal(unsigned long, unsigned int*, unsigned int*)
# CPUHint::Init() fails on this device, so cpu_hint_ is null;
# NeedsLargeCompPerfHint() returns false on the null check — before it ever
# reads this property — and the caller inverts that to true, after which the
# hint path dereferences cpu_hint_ without a guard. The crash is therefore
# independent of this value (0 and 1 both fault) and is fixed by patching the
# hint function out of the blob: tools/patch-composer-hint.py.
#
# Keep it 0 anyway so no other consumer enables the hint, which also costs
# nothing but a little scheduling latency.
vendor.display.enable_perf_hint_large_comp_cycle=0

# Display / gralloc, restored verbatim from the stock HyperOS vendor/build.prop.
#
# Same failure mode as the audio block above: this tree regenerates
# /vendor/build.prop from the files in this directory, so none of the stock
# display keys were being shipped. Every consumer of them is a stock blob —
# the SDM composer, the QTI allocator/gralloc and SurfaceFlinger — and with the
# keys absent they run on compiled-in defaults instead of the configuration
# this panel and this rotator were tuned for.
#
# The symptom that pointed here: opening the camera starts streaming
# ("CameraService: Start camera streaming"), the SDE rotator is asked to rotate
# the first preview buffer, and it never completes —
#   <SDEROT_ERR> TIMEOUT, ts:0x1/0x0, pending:1, abort:0
#   <SDEROT_ERR> VBIF XIN HALT status = 3ffd0000
# — about 0.6 s later the device reboots. vendor.display.disable_rotator_ubwc=1
# is the stock setting that keeps the rotator off the UBWC path, and
# vendor.display.comp_mask / vds_allow_hwc / disable_layer_stitch define the
# composition strategy the stock composer expects.
#
# ro.sf.lcd_density is deliberately not copied: the stock value is 450, this
# tree sets 420 in system.prop and the panel is being brought up at 420.
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.use_color_management=true
ro.surface_flinger.wcg_composition_dataspace=142671872
ro.surface_flinger.protected_contents=true
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
debug.sf.hw=0
debug.sf.enable_hwc_vds=0
debug.sf.latch_unsignaled=1
debug.sf.high_fps_late_app_phase_offset_ns=1000000
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.high_fps_late_sf_phase_offset_ns=-5000000
debug.sf.high_fps_early_phase_offset_ns=-5000000
debug.sf.high_fps_early_gl_phase_offset_ns=-5000000
debug.sf.enable_gl_backpressure=0
debug.sf.predict_hwc_composition_strategy=0
vendor.display.vds_allow_hwc=1
vendor.gralloc.disable_ubwc=0
vendor.gralloc.secure_preview_buffer_format=420_sp
vendor.display.disable_scaler=0
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.comp_mask=8388608
vendor.display.enable_posted_start_dyn=1
vendor.display.enable_optimize_refresh=1
vendor.display.use_smooth_motion=1
vendor.display.enable_camera_smooth=1
vendor.display.enable_allow_idle_fallback=1
vendor.display.disable_idle_time_video=1
vendor.display.disable_idle_time_hdr=1
vendor.display.enable_display_extensions=1
vendor.display.idle_time=0
vendor.display.disable_rotator_ubwc=1
vendor.display.normal_noc_efficiency_factor=0.85
vendor.display.camera_noc_efficiency_factor=0.70
vendor.display.disable_layer_stitch=0
vendor.display.secure_preview_buffer_format=420_sp
vendor.display.disable_hw_recovery_dump=1
vendor.display.enable_async_powermode=1
vendor.display.enable_null_display=0
vendor.display.enable_fp_monitor=1

# Camera, stock value. The QTI camera HAL reads this before building its
# processing pipeline; with it unset the HAL runs ZSL on a sensor/chipset combo
# that stock disables it for.
camera.disable_zsl_mode=1

# Bluetooth A2DP: software encoding, not hardware offload.
#
# Stock ran offload here because it ran QTI's own stack (libbluetooth_qti.so),
# which starts the DSP session through a vendor HAL op. That library is not in
# this image, so the AOSP stack drives the controller itself, and its offload
# start is bta_av_vendor_offload_start() -> HCI_CONTROLLER_A2DP (opcode 0xFD5D).
# btsnoop on this firmware shows the controller answering that command with a
# single 0x01 byte ("unknown command") and never sending a Command Complete, so
# the DSP session is never created: btif_a2dp_on_offload_started() sees
# BTA_AV_FAIL, acks FAILURE, and the stream ping-pongs STARTED->STOPPED while
# the headset stays silent. There is no host-side way to make that opcode work.
#
# persist.bluetooth.a2dp_offload.disabled is what btif_av_is_a2dp_offload_running()
# checks. With it set, the stack opens the AIDL bluetooth audio HAL with
# A2DP_SOFTWARE_ENCODING_DATAPATH and encodes SBC/AAC in software. That route
# needs IBluetoothAudioProviderFactory/default (registered by our
# bluetooth-audio service) and an A2DP output stream in the audio HAL; both are
# present - audio_policy advertises the "BT A2DP Out" mix ports.
#
# persist.bluetooth.bluetooth_audio_hal.disabled stays at its default (false):
# the AIDL bluetooth audio HAL is used, and the QTI HIDL one is offload-only.
# ro.bluetooth.library_name is deliberately NOT copied - stock pointed it at
# libbluetooth_qti.so, which is absent here.
#
# The cap lists are the ones stock shipped. They only matter while offload is
# enabled, but the Java stack still advertises them.
ro.bluetooth.a2dp_offload.supported=true
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac
persist.bluetooth.a2dp_offload.disabled=true
# Stock key, read by the QTI BT vendor HAL. We were only carrying the
# persist.vendor.qcom.bluetooth.* twin below.
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=false
persist.vendor.qcom.bluetooth.enable.splita2dp=true
persist.vendor.qcom.bluetooth.twsp_state.enabled=false
persist.vendor.qcom.bluetooth.scram.enabled=false
ro.vendor.bluetooth.wipower=false

# Radio, restored from the stock vendor/build.prop. These are read by the same
# libril-qc-hal-qmi blobs this image ships; without them the modem runs on
# compiled-in defaults instead of the configuration stock validated against
# this firmware, which shows up as slow/refused network searches and no sib16
# (the SIB16 carrier-info path IMS uses for VoLTE).
persist.radio.multisim.config=dsds
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.rat_on=combine
persist.vendor.radio.sib16_support=1
