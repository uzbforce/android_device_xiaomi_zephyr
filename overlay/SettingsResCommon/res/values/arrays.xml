<!--
     The stock carrier config carries world_phone_bool=true, so Settings shows
     the world-mode "Preferred network type" list (preferred_network_mode_key)
     instead of the LTE/3G/2G one. The AOSP list has 34 entries covering CDMA,
     TD-SCDMA and NR, none of which this modem has.

     Keep only the LTE/GSM/WCDMA combinations the SM6225-AF modem supports.
     Values are the RIL NETWORK_MODE_* constants from
     TelephonyManager.NETWORK_MODE_*, in the same order as the choices below.
-->
<resources>
    <string-array name="preferred_network_mode_choices">
        <item>LTE/GSM/WCDMA</item>
        <item>LTE/WCDMA</item>
        <item>LTE only</item>
        <item>GSM/WCDMA auto</item>
        <item>WCDMA only</item>
        <item>GSM only</item>
    </string-array>
    <string-array name="preferred_network_mode_values" translatable="false">
        <item>"9"</item>
        <item>"12"</item>
        <item>"11"</item>
        <item>"3"</item>
        <item>"2"</item>
        <item>"1"</item>
    </string-array>
</resources>
