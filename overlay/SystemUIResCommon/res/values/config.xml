<!--
     Regenerated from product/overlay/SystemUIResCommon_Sys.apk of
     zephyr_global_images_OS3.0.310.0.WBUMIXM_16.0 by tools/port-overlays.py.
     The values are the ones the stock overlay itself carries.
-->
<resources>
    <!-- the two wellbeing tiles are Play Services apps and are inert without them; -->
    <!-- the entry is kept because the array replaces SystemUI's default list -->
    <string-array name="config_quickSettingsAutoAdd" translatable="false">
        <item>accessibility_display_inversion_enabled:inversion</item>
        <item>wind_down_first_time_setup:custom(com.google.android.apps.wellbeing/.screen.ui.GrayscaleTileService)</item>
        <item>focus_mode_first_time_setup:custom(com.google.android.apps.wellbeing/.focusmode.quicksettings.FocusModeTileService)</item>
    </string-array>

    <!-- legacy key that HyperOS SystemUI reads; kept as shipped -->
    <bool name="doze_display_state_supported">true</bool>

    <dimen name="pixel_pitch">50</dimen>

    <!-- The lockscreen charging text is drawn by the indication area, anchored
         keyguard_indication_margin_bottom above the bottom edge. This panel's
         UDFPS is centred at y=2198 with an 89px radius (config_udfps_sensor_props),
         so the sensor starts 287px above the bottom edge and the padlock sits
         just above that. AOSP's 32dp (84px) put "Charging - 58%" inside the
         sensor circle, underneath the padlock. 126dp = 331px leaves the text
         ~44px above the sensor. -->
    <dimen name="keyguard_indication_margin_bottom">126dp</dimen>
</resources>
