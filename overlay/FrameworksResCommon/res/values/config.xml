    <!-- Goodix under-display fingerprint sensor. The format is
         {centerX, centerY, radius}, not the top-left corner the stock vendor
         prop persist.vendor.sys.fp.fod.location.X_Y carries: that prop is
         451,2109 for a 178x178 px sensor window, so the center is
         451+89,2109+89 = 540,2198 and the radius stays 89. AuthService and
         HidlFingerprintSensorConfig read this array to classify the HIDL 2.1
         HAL as UNDER_DISPLAY_OPTICAL and to place the SystemUI icon, the
         touch target and the lockscreen padlock. -->
    <integer-array name="config_udfps_sensor_props" translatable="false">
        <item>540</item>
        <item>2198</item>
        <item>89</item>
    </integer-array>

