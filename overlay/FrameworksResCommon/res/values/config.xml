<resources>
    <!-- The stock HyperOS curve stopped at 255 lux, so every ordinary lit room
         (300-500 lux) and every overcast day already mapped to the last
         control point and the panel sat at maximum brightness. The curve below
         keeps the same 0-255 backlight scale but extends the lux levels into
         the range the light sensor actually reports.

         The first revision of this curve still bottomed out at 10 backlight,
         which is also the framework's default screen brightness minimum, so a
         dark room sat at 4% of full scale - still clearly lit at night, and
         the auto output could not go any lower because it is clamped to that
         minimum. The values below start at 3 and rise more gently through the
         10-350 lux band, and config_screenBrightnessSettingMinimum is lowered
         so the clamp does not undo the low end. -->
    <integer-array name="config_autoBrightnessLcdBacklightValues" translatable="false">
        <item>3</item>
        <item>6</item>
        <item>12</item>
        <item>22</item>
        <item>38</item>
        <item>60</item>
        <item>90</item>
        <item>130</item>
        <item>180</item>
        <item>225</item>
        <item>255</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLevels" translatable="false">
