        <item>700</item>
        <item>1200</item>
        <item>2500</item>
        <item>5000</item>
        <item>10000</item>
    </integer-array>

    <!-- Auto-brightness output is clamped to the screen brightness range, so
         without this the 3 above would be raised back to the AOSP default of
         10 and the dark end of the curve would have no effect. 2 still keeps
